{
  "manifest_version": 3,
  "name": "Site Wipe",
  "version": "1.0.1",
  "description": "Clear cookies, cache, IndexedDB, local storage and session storage for the site you're currently on — one click, with confirmation.",
  "homepage_url": "https://github.com/jakobudovic/site-wipe",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["cookies", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Wipe",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
